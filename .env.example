# PrepX environment variables
# Copy this file to `.env` and fill in your Supabase project values.
# Without these values the app runs in local demo-auth mode so every
# screen stays navigable — no secrets are ever shipped to the frontend.

# Supabase project URL, e.g. https://your-project.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key — safe for the browser.
VITE_SUPABASE_ANON_KEY=